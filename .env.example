# Flask Portfolio — Environment Configuration
# Copy this file to .env and edit the values. NEVER commit your real .env.

# Secret key used to sign session cookies and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be changed in production.
SECRET_KEY=change-me-please-generate-a-real-secret-key-here

# Database file path (relative to instance folder by default).
# Leave as-is for a standard installation.
DATABASE_PATH=portfolio.db

# Maximum upload size in megabytes (default 5 MB).
MAX_UPLOAD_MB=5

# Enable debug mode ONLY for local development. Must be false in production.
FLASK_DEBUG=false

# Base URL of the site (used for sitemap.xml and absolute links).
# Example: https://yourdomain.com
SITE_URL=http://localhost:8000
